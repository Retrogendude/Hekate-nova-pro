--- btstack-upstream/src/classic/hid_host.c
+++ nova26/classic/hid_host.c
@@ -895,6 +895,22 @@
 
                     switch (l2cap_event_incoming_connection_get_psm(packet)){
                         case PSM_HID_CONTROL:
+#ifdef NOVA_HID_KNOWN_PSMS
+                            /* Joy-Con reconnects can cross our control open.
+                             * Reuse the HID session and let the peer's channel
+                             * win while our own control open is still pending.
+                             * The old L2CAP CID remains owned by L2CAP until its
+                             * response/timeout; its callback is filtered below. */
+                            if (connection && !connection->incoming &&
+                                connection->requested_protocol_mode == HID_PROTOCOL_MODE_REPORT &&
+                                connection->state == HID_HOST_W4_CONTROL_CONNECTION_ESTABLISHED){
+                                connection->con_handle = con_handle;
+                                connection->control_cid = l2cap_event_incoming_connection_get_local_cid(packet);
+                                connection->incoming = true;
+                                hid_emit_incoming_connection_event(connection->hid_cid, address, con_handle, ERROR_CODE_SUCCESS);
+                                break;
+                            }
+#endif
                             if (connection){
                                 l2cap_decline_connection(channel);
                                 break; 
@@ -921,6 +937,17 @@
                                 l2cap_decline_connection(channel);
                                 break;
                             }
+#ifdef NOVA_HID_KNOWN_PSMS
+                            /* Only one incoming interrupt channel may win. An
+                             * outgoing interrupt still awaiting its response
+                             * may be superseded in the same way as control. */
+                            if (connection->incoming && connection->interrupt_cid){
+                                l2cap_decline_connection(channel);
+                                break;
+                            }
+                            if (connection->requested_protocol_mode == HID_PROTOCOL_MODE_REPORT)
+                                connection->incoming = true;
+#endif
                             
                             connection->state = HID_HOST_W4_INTERRUPT_CONNECTION_ESTABLISHED;
                             connection->interrupt_cid = l2cap_event_incoming_connection_get_local_cid(packet);
@@ -937,12 +964,25 @@
 
                 case L2CAP_EVENT_CHANNEL_OPENED: 
                     l2cap_event_channel_opened_get_address(packet, address); 
+#ifdef NOVA_HID_KNOWN_PSMS
+                    /* Match the canonical CID, not merely the peer address.
+                     * A superseded outgoing open may complete or time out after
+                     * the incoming session is active, or after a reconnect. */
+                    l2cap_cid = l2cap_event_channel_opened_get_local_cid(packet);
+                    connection = hid_host_get_connection_for_l2cap_cid(l2cap_cid);
+                    if (!connection || memcmp(connection->remote_addr, address, 6) != 0){
+                        if (l2cap_event_channel_opened_get_status(packet) == ERROR_CODE_SUCCESS)
+                            l2cap_disconnect(l2cap_cid);
+                        break;
+                    }
+#else
                    
                     connection = hid_host_get_connection_for_bd_addr(address);
                     if (!connection){
                         log_error("Connection does not exist %s", bd_addr_to_str(address));
                         break;
                     }
+#endif
                     
                     status = l2cap_event_channel_opened_get_status(packet); 
                     if (status != ERROR_CODE_SUCCESS){
@@ -950,6 +990,15 @@
                         log_info("L2CAP connection %s failed: 0x%02xn", bd_addr_to_str(address), status);
                         hid_emit_connected_event(connection, status);
                         if (hid_host_get_connection_for_hid_cid(hid_cid) == connection) {
+#ifdef NOVA_HID_KNOWN_PSMS
+                            /* An interrupt-open failure must also close the already
+                             * established control channel before another attempt.
+                             * The failing interrupt channel is freed by L2CAP. */
+                            if (l2cap_event_channel_opened_get_psm(packet) == BLUETOOTH_PSM_HID_INTERRUPT && connection->control_cid){
+                                connection->interrupt_cid = 0;
+                                hid_host_disconnect(hid_cid);
+                            } else
+#endif
                             hid_host_finalize_connection(connection);
                         }
                         break;
@@ -977,11 +1026,19 @@
                                         log_info("Incoming interrupt connection opened: set boot mode");
                                         break;
                                     default:
+#ifdef NOVA_HID_KNOWN_PSMS
+                                        /* Nova extension: paired Joy-Con use the known
+                                         * HID channels; the application decodes reports.
+                                         * No SDP query or SET_PROTOCOL is needed here. */
+                                        connection->protocol_mode = HID_PROTOCOL_MODE_REPORT;
+                                        hid_emit_descriptor_available_event(connection);
+#else
                                         // SDP query
                                         log_info("Incoming interrupt connection opened: start SDP query");
                                         connection->state = HID_HOST_W2_SEND_SDP_QUERY;
                                         hid_host_handle_sdp_client_query_request.callback = &hid_host_handle_start_sdp_client_query;
                                         (void) sdp_client_register_query_callback(&hid_host_handle_sdp_client_query_request);
+#endif
                                         break;
                                 }
                                 break;
@@ -1011,6 +1068,9 @@
                                     if (status){
                                         log_info("Connecting to HID Interrupt failed: 0x%02x", status);
                                         hid_emit_connected_event(connection, status);
+#ifdef NOVA_HID_KNOWN_PSMS
+                                        hid_host_disconnect(connection->hid_cid);
+#endif
                                         break;
                                     }
                                     connection->protocol_mode = connection->requested_protocol_mode;
@@ -1291,9 +1351,23 @@
             status = l2cap_create_channel(hid_host_packet_handler, connection->remote_addr, BLUETOOTH_PSM_HID_CONTROL, 0xffff, &connection->control_cid);
             break;
         default:
+#ifdef NOVA_HID_KNOWN_PSMS
+            /* Nova extension: standard Classic HID control then interrupt.
+             * Security still goes through the normal L2CAP authentication. */
+            connection->control_psm = BLUETOOTH_PSM_HID_CONTROL;
+            connection->interrupt_psm = BLUETOOTH_PSM_HID_INTERRUPT;
+            connection->state = HID_HOST_W4_CONTROL_CONNECTION_ESTABLISHED;
+            status = l2cap_create_channel(hid_host_packet_handler, connection->remote_addr,
+                connection->control_psm, 0xffff, &connection->control_cid);
+            if (status){
+                hid_host_finalize_connection(connection);
+                *hid_cid = 0;
+            }
+#else
             hid_host_handle_sdp_client_query_request.callback = &hid_host_handle_start_sdp_client_query;
             // ignore ERROR_CODE_COMMAND_DISALLOWED because in that case, we already have requested an SDP callback
             (void) sdp_client_register_query_callback(&hid_host_handle_sdp_client_query_request);
+#endif
             break;
     }
     return status;
